# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# 虚拟环境
venv/
.venv/
env/

# IDE
.vscode/
.idea/
.obsidian/
*.swp
*.swo

# 操作系统
.DS_Store
Thumbs.db

# 历史存档（不需要提交）
archive/

# 用户个人数据（inputs/ 全部不提交，用户自行放入）
inputs/raw_docx_articles/*
inputs/normalized_markdown/*
inputs/filtered_markdown/*
inputs/template_stripped_markdown/*
inputs/ai_drafts/*

# 用户产出（DNA画像、改写结果等）
outputs/dna_profiles/*
outputs/rewrite_runs/*
outputs/debug/*
outputs/model_benchmarks/*
outputs/reports/*
outputs/*.json
outputs/*.png
outputs/*_cmp_*.png

# 保留目录结构和README
!inputs/raw_docx_articles/.gitkeep
!inputs/normalized_markdown/.gitkeep
!inputs/filtered_markdown/.gitkeep
!inputs/template_stripped_markdown/.gitkeep
!inputs/ai_drafts/.gitkeep
!outputs/dna_profiles/.gitkeep
!outputs/rewrite_runs/.gitkeep
!outputs/debug/.gitkeep
!outputs/README.md

# 配置文件（用户本地）
config.local.yaml
.claude/settings.local.json

# 临时文件
*.tmp
*.log

# 文档图片（含敏感信息的示例图不提交）
docs/images/*example*
docs/images/*测评*
docs/images/*某人*

# 开发者内部文件（不提交）
PROJECT_STATUS.md
docs/writing-dna-prd.md
outputs/比赛交付物_图文帖子.md
scripts/comparison_to_png.py
scripts/slop_report_to_png.py
